# CyberShield X configuration. Copy this file to ".env" and fill in only what you have.
# Every key is OPTIONAL. Without a key the provider is shown as "Not Configured",
# analysis continues with local analysis and the other sources, and the app never
# treats a missing key as "no threat found".
# Never commit your real .env file and never share it.

# --- Optional threat-intelligence providers ---
PHISHTANK_API_KEY=
URLHAUS_API_KEY=
MALWAREBAZAAR_API_KEY=
URLSCAN_API_KEY=
IPINFO_TOKEN=
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# --- Optional AI enhancement (user-supplied key, OpenAI-compatible API) ---
# Paste a key in Settings instead to avoid restarting; the .env values below
# are the fallback defaults. Works with OpenAI, any OpenAI-compatible endpoint,
# or a local server such as Ollama (e.g. http://localhost:11434/v1).
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# --- Application ---
# Start in Demo Mode (prepared demonstration data, clearly labelled). true / false
CYBERSHIELD_DEMO_MODE=false
# Use 127.0.0.1 for this laptop only. Use 0.0.0.0 to allow other devices on your LAN.
CYBERSHIELD_HOST=127.0.0.1
CYBERSHIELD_PORT=8000
# Maximum upload size in megabytes (1-100)
CYBERSHIELD_MAX_UPLOAD_MB=25
# Timeout for each external provider request, in seconds (1-30)
CYBERSHIELD_HTTP_TIMEOUT=8
# Retries after a timeout or server error (0-4). Rate-limit responses are never retried.
CYBERSHIELD_HTTP_RETRIES=2
# API requests allowed per client per minute
CYBERSHIELD_RATE_LIMIT=120
# SQLite database location (default: data/cybershield.db)
# CYBERSHIELD_DB_PATH=
